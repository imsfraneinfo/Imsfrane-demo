  "camping": {
    "CAMPING • IMSFRANE CATHÉDRALE": {
      "ar": "التخييم · مسفران كاتدرال",
      "es": "ACAMPADA · IMSFRANE CATHÉDRALE"
    },
    "Une nuit sous les étoiles": {
      "ar": "ليلة تحت النجوم",
      "es": "Una noche bajo las estrellas"
    },
    "au cœur de l’Atlas.": {
      "ar": "في قلب الأطلس الكبير.",
      "es": "en el corazón del Atlas."
    },
    "Au bord de l’oued Ahansal, vivez une parenthèse authentique entre forêt, montagnes et soirées autour du camp.": {
      "ar": "عِش تجربة تخييم أصيلة على ضفاف وادي أحنصال، بين الغابات والجبال وأمسيات الطبيعة الهادئة.",
      "es": "Acampa junto al río Ahansal, entre bosques y montañas, y disfruta de noches tranquilas rodeado de naturaleza."
    },
    "Découvrir nos photos": {
      "ar": "اكتشف صورنا",
      "es": "Descubre nuestras fotos"
    },
    "UNE EXPÉRIENCE NATURE": {
      "ar": "تجربة في أحضان الطبيعة",
      "es": "UNA EXPERIENCIA EN LA NATURALEZA"
    },
    "Le charme du camping à Imsfrane": {
      "ar": "سحر التخييم في مسفران",
      "es": "El encanto de acampar en Imsfrane"
    },
    "Des journées au bord de la rivière et des nuits sous les arbres : découvrez l’ambiance du bivouac dans l’Atlas marocain.": {
      "ar": "أيام قرب النهر وليالٍ تحت الأشجار: استمتع بأجواء التخييم وسط طبيعة الأطلس الكبير.",
      "es": "Días junto al río y noches entre árboles: descubre la esencia de la acampada en el Atlas marroquí."
    },
    "Au bord de la rivière": {
      "ar": "على ضفاف النهر",
      "es": "Junto al río"
    },
    "Profitez de la fraîcheur de l’oued et de l’ombre des arbres.": {
      "ar": "استمتع بنسيم الوادي وظلال الأشجار.",
      "es": "Disfruta del aire fresco del río y de la sombra de los árboles."
    },
    "Des nuits mémorables": {
      "ar": "ليالٍ لا تُنسى",
      "es": "Noches memorables"
    },
    "Partagez des moments uniques sous un ciel étoilé.": {
      "ar": "عِش لحظات استثنائية تحت سماء مرصعة بالنجوم.",
      "es": "Comparte momentos únicos bajo un cielo estrellado."
    },
    "Un cadre naturel": {
      "ar": "بيئة طبيعية ساحرة",
      "es": "Un entorno natural"
    },
    "Des tentes au milieu de la nature et des paysages de montagne.": {
      "ar": "خيام وسط الطبيعة والمناظر الجبلية.",
      "es": "Tiendas rodeadas de naturaleza y paisajes de montaña."
    },
    "TARIFS CAMPING": {
      "ar": "أسعار التخييم",
      "es": "TARIFAS DE ACAMPADA"
    },
    "Choisissez votre tente": {
      "ar": "اختر خيمتك",
      "es": "Elige tu tienda"
    },
    "Tarifs par tente et par nuit. Un emplacement pour votre propre tente est également disponible.": {
      "ar": "الأسعار محددة لكل خيمة في الليلة، مع إمكانية حجز مكان لنصب خيمتك الخاصة.",
      "es": "Tarifas por tienda y noche. También puedes reservar un espacio para montar tu propia tienda."
    },
    "Tente 1 personne": {
      "ar": "خيمة لشخص واحد",
      "es": "Tienda para 1 persona"
    },
    "Tente 2 personnes": {
      "ar": "خيمة لشخصين",
      "es": "Tienda para 2 personas"
    },
    "Tente 3 personnes": {
      "ar": "خيمة لثلاثة أشخاص",
      "es": "Tienda para 3 personas"
    },
    "Tente 4 personnes": {
      "ar": "خيمة لأربعة أشخاص",
      "es": "Tienda para 4 personas"
    },
    "Votre propre tente": {
      "ar": "خيمتك الخاصة",
      "es": "Tu propia tienda"
    },
    "emplacement": {
      "ar": "مكان نصب الخيمة",
      "es": "parcela"
    },
    "FORMULE TOUT COMPRIS": {
      "ar": "باقة تشمل الوجبات",
      "es": "PAQUETE CON COMIDAS INCLUIDAS"
    },
    "Camping et repas inclus": {
      "ar": "تخييم مع الوجبات",
      "es": "Acampada con comidas incluidas"
    },
    "Une nuit en tente avec petit-déjeuner, déjeuner et dîner. Cette formule est disponible uniquement sur réservation pour un groupe de 4 personnes minimum.": {
      "ar": "ليلة في خيمة تشمل الفطور والغداء والعشاء. تتوفر هذه الباقة بالحجز المسبق لمجموعة من أربعة أشخاص على الأقل.",
      "es": "Una noche en tienda con desayuno, almuerzo y cena. Esta opción requiere reserva previa y un mínimo de cuatro personas."
    },
    "/ personne": {
      "ar": "للشخص",
      "es": "/ persona"
    },
    "Repas uniquement sur demande • Minimum 4 personnes": {
      "ar": "الوجبات عند الطلب · أربعة أشخاص على الأقل",
      "es": "Comidas bajo petición · Mínimo 4 personas"
    },
    "INFORMATIONS PRATIQUES": {
      "ar": "معلومات عملية",
      "es": "INFORMACIÓN PRÁCTICA"
    },
    "Préparez votre séjour": {
      "ar": "استعد لإقامتك",
      "es": "Prepara tu estancia"
    },
    "Sur place": {
      "ar": "في المخيم",
      "es": "En el campamento"
    },
    "Espace réservé aux familles, éclairage nocturne et accès en voiture jusqu’à proximité des tentes.": {
      "ar": "مساحة مناسبة للعائلات، وإنارة ليلية، وإمكانية الوصول بالسيارة إلى قرب الخيام.",
      "es": "Zona para familias, iluminación nocturna y acceso en coche hasta las proximidades de las tiendas."
    },
    "Cuisine et repas": {
      "ar": "الطبخ والوجبات",
      "es": "Cocina y comidas"
    },
    "Vous pouvez cuisiner vous-même et utiliser les ustensiles mis à disposition, à rendre dans leur état initial. Pour les grands groupes, apportez de préférence votre matériel. Petit-déjeuner, déjeuner et dîner sur demande pour 4 personnes minimum.": {
      "ar": "يمكنك إعداد وجباتك بنفسك واستعمال أدوات المطبخ المتاحة مع إعادتها بحالة جيدة. يُفضَّل أن تحضر المجموعات الكبيرة معداتها الخاصة؛ وتتوفّر الوجبات عند الطلب لأربعـة أشخاص على الأقل.",
      "es": "Puedes cocinar y utilizar los utensilios disponibles, siempre dejándolos en buen estado. Para grupos grandes recomendamos traer material propio. Desayuno, almuerzo y cena bajo petición para un mínimo de cuatro personas."
    },
    "Situation et provisions": {
      "ar": "الموقع والتموين",
      "es": "Ubicación y provisiones"
    },
    "Imsfrane, commune de Tilouguite, province d’Azilal, entre Imi N’Ouarg et Tamga, à environ 90 km de Béni Mellal. Épicerie de légumes et viande à environ 15 minutes ; Tilouguite est à environ 10 km.": {
      "ar": "يقع المخيم في منطقة مسفران بجماعة تيلوكيت، إقليم أزيلال، بين إمي نوارك وتامگا، على بُعد نحو 90 كلم من بني ملال. توجد محلات لاقتناء الخضر واللحم على بُعد نحو 15 دقيقة، وتبعد تيلوكيت قرابة 10 كلم.",
      "es": "En Imsfrane, comuna de Tilouguite, provincia de Azilal, entre Imi N’Ouarg y Tamga, a unos 90 km de Beni Mellal. Hay tiendas de verduras y carne a unos 15 minutos, y Tilouguite está a unos 10 km."
    },
    "Comment venir": {
      "ar": "كيفية الوصول",
      "es": "Cómo llegar"
    },
    "Bus jusqu’à Béni Mellal, grand taxi pour Ouaouizeght (environ 25 DH), puis transport direct vers Imsfrane (environ 30 DH). Tarifs de transport indicatifs.": {
      "ar": "يمكن الوصول بالحافلة إلى بني ملال، ثم بسيارة أجرة كبيرة نحو واويزغت (نحو 25 درهماً)، وبعدها نقل محلي إلى مسفران (نحو 30 درهماً). هذه أثمنة إرشادية.",
      "es": "Puedes llegar en autobús a Beni Mellal, tomar un taxi compartido hasta Ouaouizeght (unos 25 MAD) y después transporte hasta Imsfrane (unos 30 MAD). Tarifas orientativas."
    },
    "Soirée amazighe": {
      "ar": "أمسية أمازيغية",
      "es": "Velada amazige"
    },
    "Sur demande, une soirée autour du feu avec Ahidous peut être organisée avec une contribution convenue entre les participants, selon les conditions de sécurité.": {
      "ar": "يمكن تنظيم أمسية أحيدوس حول النار عند الطلب، بمساهمة يُتفق عليها بين المشاركين، مع مراعاة شروط السلامة.",
      "es": "Bajo petición, se puede organizar una velada de Ahidous alrededor del fuego con una aportación acordada entre los participantes y siempre según las condiciones de seguridad."
    },
    "Voir les tentes en vidéo ↗": {
      "ar": "شاهد الخيام بالفيديو ↗",
      "es": "Ver las tiendas en vídeo ↗"
    },
    "CAMPING • PHOTO JOURNAL": {
      "ar": "صور من المخيم",
      "es": "ACAMPADA · FOTOGRAFÍAS"
    },
    "Des instants à vivre": {
      "ar": "لحظات تستحق أن تعيشها",
      "es": "Momentos para recordar"
    },
    "15 photos du camping : des nuits illuminées aux matinées près de la rivière.": {
      "ar": "15 صورة من المخيم، من ليالي التخييم إلى الصباح قرب الوادي.",
      "es": "15 fotografías de la acampada: desde noches iluminadas hasta mañanas junto al río."
    },
    "L’Atlas vous attend.": {
      "ar": "الأطلس الكبير في انتظارك.",
      "es": "El Atlas te espera."
    },
    "Organisons ensemble votre séjour camping à Imsfrane.": {
      "ar": "نساعدك على تنظيم إقامتك في مخيم مسفران.",
      "es": "Organiza con nosotros tu estancia de acampada en Imsfrane."
    }
  },
